procedure THTMLHeadElement.Connect;
var
  punk: IUnknown;
begin
  if FIntf = nil then
  begin
    punk := GetServer;
    ConnectEvents(punk);
    Fintf:= punk as DispHTMLHeadElement;
  end;
end;

procedure THTMLHeadElement.ConnectTo(svrIntf: DispHTMLHeadElement);
begin
  Disconnect;
  FIntf := svrIntf;
  ConnectEvents(FIntf);
end;

procedure THTMLHeadElement.DisConnect;
begin
  if Fintf <> nil then
  begin
    DisconnectEvents(FIntf);
    FIntf := nil;
  end;
end;

function THTMLHeadElement.GetDefaultInterface: DispHTMLHeadElement;
begin
  if FIntf = nil then
    Connect;
  Assert(FIntf <> nil, 'DefaultInterface が NULL です。コンポーネントはサーバーに接続できませんでした。操作を始める前に ''Connect'' または ''ConnectTo'' を呼ぶ必要があります。');
  Result := FIntf;
end;

