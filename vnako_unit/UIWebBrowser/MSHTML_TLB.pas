begin
  Result := CreateComObject(CLASS_HTMLFontElement) as DispHTMLFontElement;
end;

class function CoHTMLFontElement.CreateRemote(const MachineName: string): DispHTMLFontElement;
begin
  Result := CreateRemoteComObject(MachineName, CLASS_HTMLFontElement) as DispHTMLFontElement;
end;

procedure THTMLFontElement.InitServerData;
const
  CServerData: TServerData = (
    ClassID:   '{3050F27B-98B5-11CF-BB82-00AA00BDCE0B}';
    IntfIID:   '{3050F512-98B5-11CF-BB82-00AA00BDCE0B}';
    EventIID:  '{3050F33C-98B5-11CF-BB82-00AA00BDCE0B}';
    LicenseKey: nil;
    Version: 500);
begin
  ServerData := @CServerData;
end;

procedure THTMLFontElement.Connect;
var
  punk: IUnknown;
begin
  if FIntf = nil then
  begin
    punk := GetServer;
    ConnectEvents(punk);
    Fintf:= punk as DispHTMLFontElement;
  end;
end;

procedure THTMLFontElement.ConnectTo(svrIntf: DispHTMLFontElement);
begin
  Disconnect;
  FIntf := svrIntf;
  ConnectEvents(FIntf);
end;

procedure THTMLFontElement.DisConnect;
begin
  if Fintf <> nil then
  begin
    DisconnectEvents(FIntf);
    FIntf := nil;
  end;
end;

function THTMLFontElement.GetDefaultInterface: DispHTMLFontElement;
begin
  if FIntf = nil then
    Connect;
  Assert(FIntf <> nil, 'DefaultInterface が NULL です。コンポーネントはサーバーに接続できませんでした。操作を始める前に ''Connect'' または ''ConnectTo'' を呼ぶ必要があります。');
  Result := FIntf;
end;

constructor THTMLFontElement.Create(AOwner: TComponent);
begin
  inherited Create(AOwner);
{$IFDEF LIVE_SERVER_AT_DESIGN_TIME}
  FProps := THTMLFontElementProperties.Create(Self);
{$ENDIF}
end;

destructor THTMLFontElement.Destroy;
begin
{$IFDEF LIVE_SERVER_AT_DESIGN_TIME}
  FProps.Free;
{$ENDIF}
  inherited Destroy;
end;

{$IFDEF LIVE_SERVER_AT_DESIGN_TIME}
function THTMLFontElement.GetServerProperties: THTMLFontElementProperties;
begin
  Result := FProps;
end;
{$ENDIF}

procedure THTMLFontElement.InvokeEvent(DispID: TDispID; var Params: TVariantArray);
begin
  case DispID of
    -1: Exit;  // DISPID_UNKNOWN
    -2147418102: if Assigned(FOnonhelp) then
         FOnonhelp(Self);
    -600: if Assigned(FOnonclick) then
         FOnonclick(Self);
    -601: if Assigned(FOnondblclick) then
         FOnondblclick(Self);
    -603: if Assigned(FOnonkeypress) then
         FOnonkeypress(Self);
    -602: if Assigned(FOnonkeydown) then
         FOnonkeydown(Self);
    -604: if Assigned(FOnonkeyup) then
         FOnonkeyup(Self);
    -2147418103: if Assigned(FOnonmouseout) then
         FOnonmouseout(Self);
    -2147418104: if Assigned(FOnonmouseover) then
         FOnonmouseover(Self);
