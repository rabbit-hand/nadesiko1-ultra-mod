procedure THTMLFrameElement.InitServerData;
const
  CServerData: TServerData = (
    ClassID:   '{3050F314-98B5-11CF-BB82-00AA00BDCE0B}';
    IntfIID:   '{3050F513-98B5-11CF-BB82-00AA00BDCE0B}';
    EventIID:  '{3050F4EA-98B5-11CF-BB82-00AA00BDCE0B}';
    LicenseKey: nil;
    Version: 500);
begin
  ServerData := @CServerData;
end;

procedure THTMLFrameElement.Connect;
var
  punk: IUnknown;
begin
  if FIntf = nil then
  begin
    punk := GetServer;
    ConnectEvents(punk);
    Fintf:= punk as DispHTMLFrameElement;
  end;
end;

procedure THTMLFrameElement.ConnectTo(svrIntf: DispHTMLFrameElement);
begin
  Disconnect;
  FIntf := svrIntf;
  ConnectEvents(FIntf);
end;

procedure THTMLFrameElement.DisConnect;
begin
  if Fintf <> nil then
  begin
    DisconnectEvents(FIntf);
    FIntf := nil;
  end;
end;

function THTMLFrameElement.GetDefaultInterface: DispHTMLFrameElement;
begin
  if FIntf = nil then
    Connect;
  Assert(FIntf <> nil, 'DefaultInterface が NULL です。コンポーネントはサーバーに接続できませんでした。操作を始める前に ''Connect'' または ''ConnectTo'' を呼ぶ必要があります。');
  Result := FIntf;
end;

constructor THTMLFrameElement.Create(AOwner: TComponent);
begin
  inherited Create(AOwner);
{$IFDEF LIVE_SERVER_AT_DESIGN_TIME}
  FProps := THTMLFrameElementProperties.Create(Self);
{$ENDIF}
end;

destructor THTMLFrameElement.Destroy;
begin
{$IFDEF LIVE_SERVER_AT_DESIGN_TIME}
  FProps.Free;
{$ENDIF}
  inherited Destroy;
end;

