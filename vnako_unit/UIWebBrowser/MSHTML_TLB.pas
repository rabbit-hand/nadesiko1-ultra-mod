procedure THTMLTextAreaElement.InitServerData;
const
  CServerData: TServerData = (
    ClassID:   '{3050F2AC-98B5-11CF-BB82-00AA00BDCE0B}';
    IntfIID:   '{3050F521-98B5-11CF-BB82-00AA00BDCE0B}';
