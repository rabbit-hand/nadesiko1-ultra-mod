procedure TOldHTMLFormElement.InitServerData;
const
  CServerData: TServerData = (
    ClassID:   '{0D04D285-6BEC-11CF-8B97-00AA00476DA6}';
    IntfIID:   '{3050F510-98B5-11CF-BB82-00AA00BDCE0B}';
    EventIID:  '{3050F364-98B5-11CF-BB82-00AA00BDCE0B}';
    LicenseKey: nil;
    Version: 500);
begin
  ServerData := @CServerData;
end;

procedure TOldHTMLFormElement.Connect;
var
  punk: IUnknown;
begin
  if FIntf = nil then
  begin
    punk := GetServer;
    ConnectEvents(punk);
    Fintf:= punk as DispHTMLFormElement;
  end;
end;

procedure TOldHTMLFormElement.ConnectTo(svrIntf: DispHTMLFormElement);
begin
  Disconnect;
  FIntf := svrIntf;
  ConnectEvents(FIntf);
end;

procedure TOldHTMLFormElement.DisConnect;
begin
  if Fintf <> nil then
  begin
    DisconnectEvents(FIntf);
    FIntf := nil;
  end;
end;

function TOldHTMLFormElement.GetDefaultInterface: DispHTMLFormElement;
begin
  if FIntf = nil then
    Connect;
  Assert(FIntf <> nil, 'DefaultInterface が NULL です。コンポーネントはサーバーに接続できませんでした。操作を始める前に ''Connect'' または ''ConnectTo'' を呼ぶ必要があります。');
  Result := FIntf;
end;

constructor TOldHTMLFormElement.Create(AOwner: TComponent);
begin
  inherited Create(AOwner);
{$IFDEF LIVE_SERVER_AT_DESIGN_TIME}
  FProps := TOldHTMLFormElementProperties.Create(Self);
{$ENDIF}
end;

destructor TOldHTMLFormElement.Destroy;
begin
{$IFDEF LIVE_SERVER_AT_DESIGN_TIME}
  FProps.Free;
{$ENDIF}
  inherited Destroy;
end;

