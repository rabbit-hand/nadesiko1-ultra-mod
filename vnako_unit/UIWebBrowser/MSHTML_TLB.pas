    punk := GetServer;
    ConnectEvents(punk);
    Fintf:= punk as DispHTMLTitleElement;
  end;
end;

procedure THTMLTitleElement.ConnectTo(svrIntf: DispHTMLTitleElement);
begin
  Disconnect;
  FIntf := svrIntf;
  ConnectEvents(FIntf);
end;

procedure THTMLTitleElement.DisConnect;
begin
  if Fintf <> nil then
  begin
    DisconnectEvents(FIntf);
    FIntf := nil;
  end;
end;

function THTMLTitleElement.GetDefaultInterface: DispHTMLTitleElement;
begin
  if FIntf = nil then
