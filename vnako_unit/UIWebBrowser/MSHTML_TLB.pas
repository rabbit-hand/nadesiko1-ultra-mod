  if Fintf <> nil then
  begin
    DisconnectEvents(FIntf);
    FIntf := nil;
  end;
end;

function THTMLInputTextElement.GetDefaultInterface: DispIHTMLInputTextElement;
begin
  if FIntf = nil then
