procedure THTMLObjectElement.InitServerData;
const
  CServerData: TServerData = (
    ClassID:   '{3050F24E-98B5-11CF-BB82-00AA00BDCE0B}';
    IntfIID:   '{3050F529-98B5-11CF-BB82-00AA00BDCE0B}';
