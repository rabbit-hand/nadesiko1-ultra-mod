procedure THTMLDDElement.InitServerData;
const
  CServerData: TServerData = (
    ClassID:   '{3050F27F-98B5-11CF-BB82-00AA00BDCE0B}';
    IntfIID:   '{3050F50B-98B5-11CF-BB82-00AA00BDCE0B}';
