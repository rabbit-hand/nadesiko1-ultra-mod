procedure THTMLMetaElement.InitServerData;
const
  CServerData: TServerData = (
    ClassID:   '{3050F275-98B5-11CF-BB82-00AA00BDCE0B}';
    IntfIID:   '{3050F517-98B5-11CF-BB82-00AA00BDCE0B}';
