    Fintf:= punk as DispIHTMLInputTextElement;
  end;
end;

procedure THTMLInputTextElement.ConnectTo(svrIntf: DispIHTMLInputTextElement);
begin
  Disconnect;
  FIntf := svrIntf;
  ConnectEvents(FIntf);
end;

procedure THTMLInputTextElement.DisConnect;
