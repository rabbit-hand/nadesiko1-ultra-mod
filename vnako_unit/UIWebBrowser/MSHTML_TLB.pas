procedure THTMLSpanElement.InitServerData;
const
  CServerData: TServerData = (
    ClassID:   '{3050F3F5-98B4-11CF-BB82-00AA00BDCE0B}';
    IntfIID:   '{3050F548-98B5-11CF-BB82-00AA00BDCE0B}';
