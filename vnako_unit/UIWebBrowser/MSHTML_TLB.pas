  Result := CreateRemoteComObject(MachineName, CLASS_HTMLStyleElement) as DispHTMLStyleElement;
end;

procedure THTMLStyleElement.InitServerData;
const
  CServerData: TServerData = (
    ClassID:   '{3050F37D-98B5-11CF-BB82-00AA00BDCE0B}';
    IntfIID:   '{3050F511-98B5-11CF-BB82-00AA00BDCE0B}';
    EventIID:  '{3050F3CB-98B5-11CF-BB82-00AA00BDCE0B}';
    LicenseKey: nil;
    Version: 500);
begin
  ServerData := @CServerData;
end;

procedure THTMLStyleElement.Connect;
var
  punk: IUnknown;
begin
  if FIntf = nil then
  begin
    punk := GetServer;
    ConnectEvents(punk);
    Fintf:= punk as DispHTMLStyleElement;
  end;
end;

procedure THTMLStyleElement.ConnectTo(svrIntf: DispHTMLStyleElement);
begin
  Disconnect;
  FIntf := svrIntf;
  ConnectEvents(FIntf);
end;

procedure THTMLStyleElement.DisConnect;
begin
  if Fintf <> nil then
  begin
    DisconnectEvents(FIntf);
    FIntf := nil;
  end;
end;

function THTMLStyleElement.GetDefaultInterface: DispHTMLStyleElement;
begin
  if FIntf = nil then
    Connect;
  Assert(FIntf <> nil, 'DefaultInterface が NULL です。コンポーネントはサーバーに接続できませんでした。操作を始める前に ''Connect'' または ''ConnectTo'' を呼ぶ必要があります。');
  Result := FIntf;
end;

constructor THTMLStyleElement.Create(AOwner: TComponent);
begin
  inherited Create(AOwner);
{$IFDEF LIVE_SERVER_AT_DESIGN_TIME}
  FProps := THTMLStyleElementProperties.Create(Self);
{$ENDIF}
end;

destructor THTMLStyleElement.Destroy;
begin
{$IFDEF LIVE_SERVER_AT_DESIGN_TIME}
  FProps.Free;
{$ENDIF}
  inherited Destroy;
end;

