  Result := CreateRemoteComObject(MachineName, CLASS_HTMLFormElement) as DispHTMLFormElement;
end;

procedure THTMLFormElement.InitServerData;
const
  CServerData: TServerData = (
    ClassID:   '{3050F251-98B5-11CF-BB82-00AA00BDCE0B}';
    IntfIID:   '{3050F510-98B5-11CF-BB82-00AA00BDCE0B}';
    EventIID:  '{3050F364-98B5-11CF-BB82-00AA00BDCE0B}';
    LicenseKey: nil;
    Version: 500);
begin
  ServerData := @CServerData;
end;

procedure THTMLFormElement.Connect;
var
  punk: IUnknown;
begin
  if FIntf = nil then
  begin
    punk := GetServer;
    ConnectEvents(punk);
    Fintf:= punk as DispHTMLFormElement;
  end;
end;

procedure THTMLFormElement.ConnectTo(svrIntf: DispHTMLFormElement);
begin
  Disconnect;
  FIntf := svrIntf;
  ConnectEvents(FIntf);
end;

procedure THTMLFormElement.DisConnect;
begin
  if Fintf <> nil then
  begin
    DisconnectEvents(FIntf);
    FIntf := nil;
  end;
end;

function THTMLFormElement.GetDefaultInterface: DispHTMLFormElement;
begin
  if FIntf = nil then
    Connect;
  Assert(FIntf <> nil, 'DefaultInterface が NULL です。コンポーネントはサーバーに接続できませんでした。操作を始める前に ''Connect'' または ''ConnectTo'' を呼ぶ必要があります。');
  Result := FIntf;
end;

constructor THTMLFormElement.Create(AOwner: TComponent);
begin
  inherited Create(AOwner);
{$IFDEF LIVE_SERVER_AT_DESIGN_TIME}
  FProps := THTMLFormElementProperties.Create(Self);
{$ENDIF}
end;

destructor THTMLFormElement.Destroy;
begin
{$IFDEF LIVE_SERVER_AT_DESIGN_TIME}
  FProps.Free;
{$ENDIF}
  inherited Destroy;
end;

{$IFDEF LIVE_SERVER_AT_DESIGN_TIME}
function THTMLFormElement.GetServerProperties: THTMLFormElementProperties;
begin
  Result := FProps;
end;
{$ENDIF}

procedure THTMLFormElement.InvokeEvent(DispID: TDispID; var Params: TVariantArray);
begin
  case DispID of
    -1: Exit;  // DISPID_UNKNOWN
    -2147418102: if Assigned(FOnonhelp) then
         FOnonhelp(Self);
