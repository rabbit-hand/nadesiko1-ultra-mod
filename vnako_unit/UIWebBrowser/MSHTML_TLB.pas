procedure THTMLParamElement.InitServerData;
const
  CServerData: TServerData = (
    ClassID:   '{3050F83E-98B5-11CF-BB82-00AA00BDCE0B}';
    IntfIID:   '{3050F590-98B5-11CF-BB82-00AA00BDCE0B}';
