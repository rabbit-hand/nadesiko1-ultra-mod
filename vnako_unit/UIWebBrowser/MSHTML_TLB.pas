end;

procedure THTMLDTElement.InitServerData;
const
  CServerData: TServerData = (
    ClassID:   '{3050F27C-98B5-11CF-BB82-00AA00BDCE0B}';
    IntfIID:   '{3050F50D-98B5-11CF-BB82-00AA00BDCE0B}';
    EventIID:  '{3050F33C-98B5-11CF-BB82-00AA00BDCE0B}';
    LicenseKey: nil;
    Version: 500);
begin
  ServerData := @CServerData;
end;

procedure THTMLDTElement.Connect;
var
  punk: IUnknown;
begin
  if FIntf = nil then
  begin
    punk := GetServer;
    ConnectEvents(punk);
    Fintf:= punk as DispHTMLDTElement;
  end;
end;

procedure THTMLDTElement.ConnectTo(svrIntf: DispHTMLDTElement);
begin
  Disconnect;
  FIntf := svrIntf;
  ConnectEvents(FIntf);
end;

procedure THTMLDTElement.DisConnect;
begin
  if Fintf <> nil then
  begin
