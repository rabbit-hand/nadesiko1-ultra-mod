procedure THTMLDListElement.InitServerData;
const
  CServerData: TServerData = (
    ClassID:   '{3050F27D-98B5-11CF-BB82-00AA00BDCE0B}';
    IntfIID:   '{3050F53B-98B5-11CF-BB82-00AA00BDCE0B}';
