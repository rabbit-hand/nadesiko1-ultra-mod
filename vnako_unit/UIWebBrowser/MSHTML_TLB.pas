procedure THTMLWindow2.InvokeEvent(DispID: TDispID; var Params: TVariantArray);
begin
  case DispID of
    -1: Exit;  // DISPID_UNKNOWN
    1003: if Assigned(FOnonload) then
         FOnonload(Self);
    1008: if Assigned(FOnonunload) then
         FOnonunload(Self);
    -2147418102: if Assigned(FOnonhelp) then
         FOnonhelp(Self);
    -2147418111: if Assigned(FOnonfocus) then
         FOnonfocus(Self);
    -2147418112: if Assigned(FOnonblur) then
         FOnonblur(Self);
    1002: if Assigned(FOnonerror) then
         FOnonerror(Self,
                    Params[0] {const WideString},
                    Params[1] {const WideString},
                    Params[2] {Integer});
    1016: if Assigned(FOnonresize) then
         FOnonresize(Self);
    1014: if Assigned(FOnonscroll) then
         FOnonscroll(Self);
    1017: if Assigned(FOnonbeforeunload) then
         FOnonbeforeunload(Self);
    1024: if Assigned(FOnonbeforeprint) then
         FOnonbeforeprint(Self);
    1025: if Assigned(FOnonafterprint) then
         FOnonafterprint(Self);
  end; {case DispID}
end;

