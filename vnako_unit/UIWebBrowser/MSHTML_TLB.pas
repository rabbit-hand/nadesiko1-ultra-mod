uses ComObj;

class function CoHTMLStyle.Create: DispHTMLStyle;
begin
  Result := CreateComObject(CLASS_HTMLStyle) as DispHTMLStyle;
end;

class function CoHTMLStyle.CreateRemote(const MachineName: string): DispHTMLStyle;
begin
  Result := CreateRemoteComObject(MachineName, CLASS_HTMLStyle) as DispHTMLStyle;
end;

procedure THTMLStyle.InitServerData;
const
  CServerData: TServerData = (
    ClassID:   '{3050F285-98B5-11CF-BB82-00AA00BDCE0B}';
    IntfIID:   '{3050F55A-98B5-11CF-BB82-00AA00BDCE0B}';
    EventIID:  '';
    LicenseKey: nil;
    Version: 500);
begin
  ServerData := @CServerData;
end;

procedure THTMLStyle.Connect;
var
  punk: IUnknown;
begin
  if FIntf = nil then
  begin
    punk := GetServer;
    Fintf:= punk as DispHTMLStyle;
  end;
end;

procedure THTMLStyle.ConnectTo(svrIntf: DispHTMLStyle);
begin
  Disconnect;
  FIntf := svrIntf;
end;

procedure THTMLStyle.DisConnect;
begin
  if Fintf <> nil then
  begin
    FIntf := nil;
  end;
end;

function THTMLStyle.GetDefaultInterface: DispHTMLStyle;
begin
  if FIntf = nil then
    Connect;
  Assert(FIntf <> nil, 'DefaultInterface が NULL です。コンポーネントはサーバーに接続できませんでした。操作を始める前に ''Connect'' または ''ConnectTo'' を呼ぶ必要があります。');
  Result := FIntf;
end;

constructor THTMLStyle.Create(AOwner: TComponent);
begin
  inherited Create(AOwner);
{$IFDEF LIVE_SERVER_AT_DESIGN_TIME}
  FProps := THTMLStyleProperties.Create(Self);
{$ENDIF}
end;

destructor THTMLStyle.Destroy;
begin
{$IFDEF LIVE_SERVER_AT_DESIGN_TIME}
  FProps.Free;
{$ENDIF}
  inherited Destroy;
end;

{$IFDEF LIVE_SERVER_AT_DESIGN_TIME}
function THTMLStyle.GetServerProperties: THTMLStyleProperties;
begin
  Result := FProps;
end;
