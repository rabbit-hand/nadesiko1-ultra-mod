procedure THTMLAreaElement.InitServerData;
const
  CServerData: TServerData = (
    ClassID:   '{3050F283-98B5-11CF-BB82-00AA00BDCE0B}';
    IntfIID:   '{3050F503-98B5-11CF-BB82-00AA00BDCE0B}';
