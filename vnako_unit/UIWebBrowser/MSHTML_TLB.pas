    Fintf:= punk as DispHTMLNoShowElement;
  end;
end;

procedure THTMLNoShowElement.ConnectTo(svrIntf: DispHTMLNoShowElement);
begin
  Disconnect;
  FIntf := svrIntf;
  ConnectEvents(FIntf);
end;

procedure THTMLNoShowElement.DisConnect;
begin
  if Fintf <> nil then
  begin
    DisconnectEvents(FIntf);
    FIntf := nil;
  end;
end;

function THTMLNoShowElement.GetDefaultInterface: DispHTMLNoShowElement;
begin
  if FIntf = nil then
