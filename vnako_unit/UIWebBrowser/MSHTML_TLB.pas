    LicenseKey: nil;
    Version: 500);
begin
  ServerData := @CServerData;
end;

procedure THTMLDDElement.Connect;
var
  punk: IUnknown;
begin
  if FIntf = nil then
  begin
    punk := GetServer;
    ConnectEvents(punk);
    Fintf:= punk as DispHTMLDDElement;
  end;
end;

procedure THTMLDDElement.ConnectTo(svrIntf: DispHTMLDDElement);
begin
  Disconnect;
  FIntf := svrIntf;
  ConnectEvents(FIntf);
end;

procedure THTMLDDElement.DisConnect;
begin
  if Fintf <> nil then
  begin
    DisconnectEvents(FIntf);
    FIntf := nil;
  end;
end;

function THTMLDDElement.GetDefaultInterface: DispHTMLDDElement;
begin
  if FIntf = nil then
    Connect;
  Assert(FIntf <> nil, 'DefaultInterface が NULL です。コンポーネントはサーバーに接続できませんでした。操作を始める前に ''Connect'' または ''ConnectTo'' を呼ぶ必要があります。');
  Result := FIntf;
end;

constructor THTMLDDElement.Create(AOwner: TComponent);
