procedure THTMLParaElement.InitServerData;
const
  CServerData: TServerData = (
    ClassID:   '{3050F26F-98B5-11CF-BB82-00AA00BDCE0B}';
    IntfIID:   '{3050F52C-98B5-11CF-BB82-00AA00BDCE0B}';
    EventIID:  '{3050F33C-98B5-11CF-BB82-00AA00BDCE0B}';
    LicenseKey: nil;
    Version: 500);
begin
  ServerData := @CServerData;
end;

procedure THTMLParaElement.Connect;
var
  punk: IUnknown;
begin
  if FIntf = nil then
  begin
    punk := GetServer;
    ConnectEvents(punk);
    Fintf:= punk as DispHTMLParaElement;
  end;
end;

procedure THTMLParaElement.ConnectTo(svrIntf: DispHTMLParaElement);
begin
  Disconnect;
  FIntf := svrIntf;
  ConnectEvents(FIntf);
end;

procedure THTMLParaElement.DisConnect;
begin
  if Fintf <> nil then
  begin
    DisconnectEvents(FIntf);
    FIntf := nil;
  end;
end;

function THTMLParaElement.GetDefaultInterface: DispHTMLParaElement;
begin
  if FIntf = nil then
    Connect;
  Assert(FIntf <> nil, 'DefaultInterface が NULL です。コンポーネントはサーバーに接続できませんでした。操作を始める前に ''Connect'' または ''ConnectTo'' を呼ぶ必要があります。');
  Result := FIntf;
end;

constructor THTMLParaElement.Create(AOwner: TComponent);
begin
  inherited Create(AOwner);
{$IFDEF LIVE_SERVER_AT_DESIGN_TIME}
  FProps := THTMLParaElementProperties.Create(Self);
{$ENDIF}
end;

destructor THTMLParaElement.Destroy;
begin
{$IFDEF LIVE_SERVER_AT_DESIGN_TIME}
  FProps.Free;
{$ENDIF}
  inherited Destroy;
end;

{$IFDEF LIVE_SERVER_AT_DESIGN_TIME}
function THTMLParaElement.GetServerProperties: THTMLParaElementProperties;
begin
  Result := FProps;
end;
