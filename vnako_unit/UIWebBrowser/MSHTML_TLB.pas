procedure ThtmlInputImage.InitServerData;
const
  CServerData: TServerData = (
    ClassID:   '{3050F2C4-98B5-11CF-BB82-00AA00BDCE0B}';
    IntfIID:   '{3050F51D-98B5-11CF-BB82-00AA00BDCE0B}';
