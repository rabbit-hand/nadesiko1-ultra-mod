class function CoHTMLIFrame.Create: DispHTMLIFrame;
begin
  Result := CreateComObject(CLASS_HTMLIFrame) as DispHTMLIFrame;
end;

class function CoHTMLIFrame.CreateRemote(const MachineName: string): DispHTMLIFrame;
begin
  Result := CreateRemoteComObject(MachineName, CLASS_HTMLIFrame) as DispHTMLIFrame;
end;

procedure THTMLIFrame.InitServerData;
const
  CServerData: TServerData = (
    ClassID:   '{3050F316-98B5-11CF-BB82-00AA00BDCE0B}';
    IntfIID:   '{3050F51B-98B5-11CF-BB82-00AA00BDCE0B}';
    EventIID:  '{3050F4EA-98B5-11CF-BB82-00AA00BDCE0B}';
    LicenseKey: nil;
    Version: 500);
begin
  ServerData := @CServerData;
end;

procedure THTMLIFrame.Connect;
var
  punk: IUnknown;
begin
  if FIntf = nil then
  begin
    punk := GetServer;
    ConnectEvents(punk);
    Fintf:= punk as DispHTMLIFrame;
  end;
end;

procedure THTMLIFrame.ConnectTo(svrIntf: DispHTMLIFrame);
begin
  Disconnect;
  FIntf := svrIntf;
  ConnectEvents(FIntf);
end;

procedure THTMLIFrame.DisConnect;
begin
  if Fintf <> nil then
  begin
    DisconnectEvents(FIntf);
    FIntf := nil;
  end;
end;

function THTMLIFrame.GetDefaultInterface: DispHTMLIFrame;
begin
  if FIntf = nil then
    Connect;
  Assert(FIntf <> nil, 'DefaultInterface が NULL です。コンポーネントはサーバーに接続できませんでした。操作を始める前に ''Connect'' または ''ConnectTo'' を呼ぶ必要があります。');
  Result := FIntf;
end;

constructor THTMLIFrame.Create(AOwner: TComponent);
begin
  inherited Create(AOwner);
{$IFDEF LIVE_SERVER_AT_DESIGN_TIME}
  FProps := THTMLIFrameProperties.Create(Self);
{$ENDIF}
end;

destructor THTMLIFrame.Destroy;
begin
{$IFDEF LIVE_SERVER_AT_DESIGN_TIME}
  FProps.Free;
{$ENDIF}
  inherited Destroy;
end;

{$IFDEF LIVE_SERVER_AT_DESIGN_TIME}
function THTMLIFrame.GetServerProperties: THTMLIFrameProperties;
begin
  Result := FProps;
end;
{$ENDIF}

