class function CoHTMLOptionElementFactory.CreateRemote(const MachineName: string): IHTMLOptionElementFactory;
begin
  Result := CreateRemoteComObject(MachineName, CLASS_HTMLOptionElementFactory) as IHTMLOptionElementFactory;
end;

procedure THTMLOptionElementFactory.InitServerData;
const
  CServerData: TServerData = (
    ClassID:   '{3050F38D-98B5-11CF-BB82-00AA00BDCE0B}';
    IntfIID:   '{3050F38C-98B5-11CF-BB82-00AA00BDCE0B}';
    EventIID:  '';
    LicenseKey: nil;
    Version: 500);
begin
  ServerData := @CServerData;
end;

procedure THTMLOptionElementFactory.Connect;
var
  punk: IUnknown;
begin
  if FIntf = nil then
  begin
    punk := GetServer;
    Fintf:= punk as IHTMLOptionElementFactory;
  end;
end;

procedure THTMLOptionElementFactory.ConnectTo(svrIntf: IHTMLOptionElementFactory);
begin
  Disconnect;
  FIntf := svrIntf;
end;

procedure THTMLOptionElementFactory.DisConnect;
begin
  if Fintf <> nil then
  begin
    FIntf := nil;
  end;
end;

function THTMLOptionElementFactory.GetDefaultInterface: IHTMLOptionElementFactory;
begin
  if FIntf = nil then
    Connect;
  Assert(FIntf <> nil, 'DefaultInterface が NULL です。コンポーネントはサーバーに接続できませんでした。操作を始める前に ''Connect'' または ''ConnectTo'' を呼ぶ必要があります。');
  Result := FIntf;
end;

constructor THTMLOptionElementFactory.Create(AOwner: TComponent);
begin
  inherited Create(AOwner);
{$IFDEF LIVE_SERVER_AT_DESIGN_TIME}
  FProps := THTMLOptionElementFactoryProperties.Create(Self);
